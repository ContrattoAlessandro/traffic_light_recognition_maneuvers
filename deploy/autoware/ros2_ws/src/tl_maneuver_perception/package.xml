<?xml version="1.0"?>
<package format="3">
  <name>tl_maneuver_perception</name>
  <version>1.0.0</version>
  <description>RF-DETR model R traffic light maneuver perception for Autoware: image-only signal decision for the ego lane.</description>
  <maintainer email="alexandro.contratto@gmail.com">Alessandro Contratto</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>autoware_perception_msgs</exec_depend>
  <exec_depend>autoware_planning_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
